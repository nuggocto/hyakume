/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# rustfmt backups, cargo-mutants output, compiler crash dumps
**/*.rs.bk
**/mutants.out*/
rustc-ice-*.txt

# MSVC debug information
*.pdb

# Local overrides and secrets
mise.local.toml
.mise.local.toml
.env
.env.*

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
