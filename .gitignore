# Cargo build output
/target/
/fuzz/target/

# Fuzzing inputs, crash reports, and coverage. The corpus grows with every
# run; a crash worth keeping becomes a named unit test instead.
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# rustfmt backups, cargo-mutants output, compiler crash dumps
**/*.rs.bk
**/mutants.out*/
rustc-ice-*.txt

# MSVC debug information
*.pdb

# Local overrides and secrets
mise.local.toml
.mise.local.toml
.env
.env.*

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Hyakume's own files, in case its state or a receive folder is ever
# pointed inside the repository: the database, the encrypted device key,
# spools, partial files, and the socket
hyakume.db
hyakume.db-journal
identity.age
identity.age.new
*.spool
.hyakume-*
hyakume.sock
